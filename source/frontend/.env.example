# Frontend runtime base URL used by HttpClient.
# Keep '/api' to route all requests through local proxy (Vite in dev, nginx in prod).
VITE_API_BASE_URL=/api

# Dev-only: Vite proxy target for '/api' and '/swagger'.
# Example for local backend launch:
VITE_API_GATEWAY_URL=http://localhost:8080

# Optional mock flags
VITE_USE_MOCKS=false
VITE_USE_MOCKS_MOVIES=false
VITE_USE_MOCKS_REVIEWS=false
VITE_USE_MOCKS_PLAYLISTS=false
